{                                                                 #
  "case": {                                                       # case
    "tokens": 1024,                                               # 每卡 token 数
    "hidden": 6144,                                               # 输入输出维度 H
    "intermediate": 2048,                                         # 专家中间维度 I
    "ep": 4,                                                      # 卡数
    "experts": 256,                                               # 全局路由专家数
    "topk": 6,                                                    # 每 token 路由专家数
    "shared_experts": 0,                                          # 每卡共享专家数
    "routing": "random",                                          # random 或 cyclic
    "seed": 20260911,                                             # 各 rank 使用 seed + rank
    "dtype": "fp8_e5m2",                                          # fp8_e5m2 或 fp8_e4m3fn
    "warmup": 3,
    "repeats": 3                                                   # 预热次数；正式固定一次
  },                                                              #
  "device": {                                                     # device
    "ids": [                                                      # 物理设备编号
      0,                                                          #
      1,                                                          #
      2,                                                          #
      3                                                           #
    ],                                                            #
    "aic_cores": 28,                                              # 每卡 AIC 数
    "aiv_cores": 56,                                              # 每卡 AIV 数
    "slots_per_core": 4096                                       # 每核打点记录容量
  },                                                              #
  "profiling": {                                                  # profiling
    "timestamp_frequency_mhz": 1000                               # 时间戳换算频率，不调频
  },                                                              #
  "build": {                                                      # build
    "soc": "ascend950pr_957c",                                    # soc
    "platform": "Ascend950PR_957c",                               # platform
    "jobs": 2,                                                    # jobs
    "type": "Release"                                             # type
  },                                                              #
  "runtime": {                                                    # runtime
    "cann_env": "",                                               # 可填写 CANN set_env.sh 路径；空字符串沿用已加载环境
    "omp_threads": 1,                                             # OpenMP 线程数
    "distributed_timeout": 180                                    # 分布式超时秒数
  }                                                               #
}                                                                 #
