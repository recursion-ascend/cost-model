{                                                                 #
  "case": {                                                       # case
    "tokens": 8192,                                                 # 每卡 token 数（固定 workload）
    "hidden": 6144,                                               # 输入输出维度 H（GMM2 N 宽）
    "intermediate": 2048,                                         # 专家中间维度 I（hiddenDim = 2I = 4096）
    "ep": 4,                                                      # 卡数 P
    "experts": 256,                                               # 全局路由专家数（本卡 64）
    "topk": 8,                                                    # 每 token 路由专家数
    "shared_experts": 1,                                          # 每卡共享专家数
    "routing": "random",                                          # 固定 seed 随机无放回 top-k
    "seed": 20260920,                                             # 各 rank 使用 seed + rank，全实验不变
    "dtype": "fp8_e5m2",                                          # MXFP8 E5M2 激活/权重
    "warmup": 3,                                                  # 预热次数（>=5）
    "repeats": 3                                                 # 正式测量次数，逐次保存 raw
  },                                                              #
  "device": {                                                     # device
    "ids": [                                                      # 物理设备编号
      0,                                                          #
      1,                                                          #
      2,                                                          #
      3                                                           #
    ],                                                            #
    "aic_cores": 28,                                              # 每卡 AIC 数
    "aiv_cores": 56,                                              # 每卡 AIV 数
    "slots_per_core": 8192                                        # 每核打点槽位（实测峰值 362/core，2.8x 余量）
  },                                                              #
  "profiling": {                                                  # profiling
    "timestamp_frequency_mhz": 1000                               # 时间戳换算频率，不调频
  },                                                              #
  "build": {                                                      # build
    "soc": "ascend950pr_957c",                                    # soc
    "platform": "Ascend950PR_957c",                               # platform
    "jobs": 2,                                                    # jobs
    "type": "Release"                                             # type
  },                                                              #
  "runtime": {                                                    # runtime
    "cann_env": "",                                               # 沿用已加载环境
    "omp_threads": 1,                                             # OpenMP 线程数
    "distributed_timeout": 180                                    # 分布式超时秒数
  }                                                               #
}                                                                 #
